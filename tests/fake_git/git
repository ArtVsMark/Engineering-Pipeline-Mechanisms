#!/bin/sh
# Подделка git для проверки сторожа. ОТВЕЧАЕТ ПО ПОДКОМАНДЕ, А НЕ НА ВСЁ СРАЗУ:
# первая редакция отдавала голову на ЛЮБОЙ `rev-parse`, включая запрос о ветке
# на площадке, — и запрет на воскрешение слитой ветки в проверках не исполнялся
# вовсе, выглядя при этом проверенным (146).
#
# FAKE_HEAD_BROKEN=<причина> заставляет её отказать на чтении головы — так
# проверяется, что сторож, не сумевший узнать голову, отвергает толчок.
# FAKE_REMOTE_GONE=1 — ссылки origin/<ветка> нет: площадка её удалила.
# FAKE_MERGED=1 — голова достижима из общей ветки: работа слита.
case "$1 $2" in
  "rev-parse --abbrev-ref")
    if [ -n "$FAKE_HEAD_BROKEN" ]; then echo "$FAKE_HEAD_BROKEN" >&2; exit 128; fi
    echo "${FAKE_HEAD:-agent/here}"; exit 0 ;;
  "rev-parse --verify")
    [ -n "$FAKE_REMOTE_GONE" ] && exit 1
    echo "деадбиф"; exit 0 ;;
  "config --get")
    # ОТВЕТ ДАЁТСЯ ПРО ЗАПРОШЕННУЮ ВЕТКУ, А НЕ ПРО ГОЛОВУ: спрашивают
    # `branch.<имя>.merge`, и первая редакция отдавала на это имя ГОЛОВЫ —
    # то есть врала ровно в том поле, по которому сторож и решает (170).
    # Имя переменной латиницей: POSIX sh кириллицу в именах не принимает, и
    # dash падает на ней «not found». Прочее здесь по-русски, как в дереве.
    wanted=$(echo "$3" | sed -e 's/^branch\.//' -e 's/\.merge$//')
    # Слежение за ЧУЖОЙ веткой — так git настраивает новую ветку, отрезанную от
    # origin/main: `branch.<новая>.merge = refs/heads/main`.
    [ -n "$FAKE_UPSTREAM_ELSEWHERE" ] && { echo "refs/heads/main"; exit 0; }
    # След толчка — ОТДЕЛЬНЫЙ рычаг. Сцепив его с исчезновением ссылки, подделка
    # объявила бы «слитую, но не удалённую» ветку невозможной — а она возможна
    # и есть предмет второго признака (170).
    [ -n "$FAKE_TRACKED$FAKE_REMOTE_GONE" ] && { echo "refs/heads/${wanted}"; exit 0; }
    exit 1 ;;
  "merge-base --is-ancestor")
    [ -n "$FAKE_MERGED" ] && exit 0
    exit 1 ;;
esac
exit 1
